# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is git-ignored — your token never gets committed.

# Hetzner Cloud API token (Console -> Security -> API Tokens, Read & Write).
hcloud_token = "PASTE_YOUR_HETZNER_TOKEN_HERE"

# ---- Optional overrides (defaults shown) ----
# server_type     = "cpx31"   # 4 vCPU / 8 GB / 160 GB NVMe. Bump to cpx41 for 16 GB.
# location        = "fsn1"     # Falkenstein, DE. Alternatives: nbg1, hel1.
# node_version    = "22"
# use_floating_ip = true
# control_domain  = ""         # e.g. "control.yourdomain.com" once you have DNS.
# ssh_public_key_path = "~/.ssh/node-runner.pub"
