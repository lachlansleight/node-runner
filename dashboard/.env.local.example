# Copy to .env.local for local dev; set the same vars in Vercel project settings.

# The agent's HTTPS control endpoint.
AGENT_URL=https://noderunner.of.glass

# The agent bearer token (from /etc/node-runner/secrets.env on the box).
AGENT_TOKEN=

# Password to log into this dashboard.
DASHBOARD_PASSWORD=

# Random string used to sign the session cookie (e.g. `openssl rand -hex 32`).
AUTH_SECRET=
